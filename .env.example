# Número de WhatsApp para confirmar citas: 57 + celular, sin espacios ni signos.
NEXT_PUBLIC_WHATSAPP=573000000000

# URL que recibe cada solicitud de cita como JSON (POST): un webhook de Zapier, Make,
# n8n o Google Apps Script que la guarde en una hoja de cálculo o la envíe por correo.
# Sin esta variable, la API valida la solicitud y la registra en el log del servidor.
CITAS_WEBHOOK_URL=

# Dirección pública del sitio, para el mapa del sitio y las etiquetas de redes sociales.
NEXT_PUBLIC_SITIO_URL=https://arroyoguzman.co
